# ---------------------------------------------------------------------------
# CM Event Leads - environment variables
# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in the values from your Supabase project.
#   cp .env.example .env
#
# Supabase Dashboard -> Project Settings -> API
#   Project URL   -> VITE_SUPABASE_URL
#   anon / public -> VITE_SUPABASE_ANON_KEY
#
# NEVER put the service_role key here. It would be visible to everyone.
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: base path for GitHub Pages (e.g. /cm-event-leads/). Leave empty for root hosting.
VITE_BASE_PATH=
